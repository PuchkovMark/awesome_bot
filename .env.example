# Замените заполнители своими секретами. Настоящий .env не добавляйте в Git.
VK_TOKEN=replace-with-vk-community-token
OPENCODE_API_KEY=replace-with-opencode-api-key
LLM_MODEL=deepseek-v4.1-flash
# Общая модель для помощников и сжатия переписки.
LLM_AUX_MODEL=claude-haiku-5-5
# Общий предел, предел фоновых вызовов и ожидание в миллисекундах.
LLM_CONCURRENT_CALLS=4
LLM_BACKGROUND_CALLS=1
LLM_SLOT_WAIT_MS=10000
# Порог 5xx, окно и задержки восстановления в миллисекундах.
LLM_SERVER_FAILURE_THRESHOLD=3
LLM_SERVER_FAILURE_WINDOW_MS=30000
LLM_PROVIDER_PAUSE_MS=30000
LLM_PROVIDER_MAX_PAUSE_MS=300000
SUMMARY_INTERVAL_MS=300000
SUMMARY_FRAGMENT_SIZE=250
LOG_LEVEL=info
BOT_OWNER_ID=vk:replace-with-owner-id
ADMIN_REVOCATION_REASON_MAX_LENGTH=500
ADMIN_REVOCATION_REASON_RETENTION_DAYS=90
VERSION_TEXT_MAX_LENGTH=32000
VERSION_MAX_PER_ENTITY=100
VK_GROUP_ID=replace-with-vk-community-id
DATABASE_PATH=./awesome-bot.sqlite
MODEL_CONTEXT_TOKENS=replace-with-model-context-limit
MESSAGE_RETENTION_DAYS=30
LLM_SESSION_SECRET=replace-with-stable-independent-secret
CHAT_RESPONSES_PER_MINUTE=6
CHAT_MENTION_FLOOD_THRESHOLD=5
CHAT_MENTION_FLOOD_WINDOW_MS=10000
