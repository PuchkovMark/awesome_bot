# Токен доступа сообщества VK, используемый ботом для Long Poll и отправки сообщений.
VK_TOKEN=your_vk_group_token_here
# Необязательный сервисный ключ приложения VK для публичных записей, друзей, сообществ и фото.
VK_SERVICE_TOKEN=
# Числовой ID сообщества VK без префикса club.
VK_GROUP_ID=12345678

# URL единственной базы SQLite; относительный путь считается от prisma/schema.prisma.
DATABASE_URL=file:./dev.db

# API-ключ OpenAI; нужен для изображений, голоса и анализа медиа.
OPENAI_API_KEY=
# Необязательный ключ для семантического поиска памяти; по умолчанию используется OPENAI_API_KEY.
MEMORY_EMBEDDING_API_KEY=
# Модель OpenAI Embeddings; keyword-поиск остаётся доступен, если ключ не задан.
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Модель OpenAI для анализа изображений и документов.
OPENAI_MODEL=gpt-4.1-mini
# Название модели OpenAI для распознавания речи.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Название модели OpenAI для синтеза речи.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Глобально включает обработку голосовых; пользователь дополнительно включает её командой /voice on.
VOICE_ENABLED=true
# API-ключ OpenCode Console для текстовой модели Gemini 4 Argon.
OPENCODE_API_KEY=
# Уровень рассуждения: low, medium или high; по умолчанию low.
AI_EFFORT=low
# Общий лимит токенов рассуждения и ответа на один запрос к модели (не более 32768).
AI_MAX_OUTPUT_TOKENS=32768
# Базовый URL OpenCode API.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Название модели OpenAI Images API.
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Основной поисковый провайдер: none отключает поиск; serper и tavily автоматически переключаются друг на друга при сбое.
WEB_SEARCH_PROVIDER=serper
# API-ключи Serper и Tavily; для отказоустойчивости рекомендуется настроить оба.
SERPER_API_KEY=
TAVILY_API_KEY=
# Временная зона по умолчанию для «Мема дня» (IANA); беседа может задать собственную.
MEMEDAY_TIMEZONE=UTC

# Список VK ID администраторов через запятую; создатель Mark Puchkov (388581097) имеет высшую роль автоматически.
VK_ADMIN_IDS=
# Ограничивает доступ к генерации/редактированию изображений и анализу медиа администраторами.
IMAGE_ADMIN_ONLY=true
# Максимум операций генерации и редактирования изображений на пользователя за UTC-день.
IMAGE_MAX_PER_USER_PER_DAY=20
# Максимальное число автоматических повторов запроса к ИИ-провайдеру.
AI_MAX_RETRIES=2
# Максимум обрабатываемых запросов одного пользователя за минуту.
MAX_REQUESTS_PER_MINUTE=10
# Максимум сообщений истории, передаваемых в контекст модели.
MAX_HISTORY_MESSAGES=30
# Максимальная длина входящего текстового сообщения в символах.
MAX_INPUT_CHARS=12000

# Порт HTTP-сервера приложения, если он используется.
PORT=3000
# Уровень журналирования, например info, warn или error.
LOG_LEVEL=info
# Имя бота, распознаваемое как обращение к нему в беседе.
BOT_NAME=awesome_bot
# Срок хранения контекста в часах; приложение ограничивает значение максимумом 24 часа.
CONTEXT_TTL_HOURS=24
# Приблизительный лимит токенов истории диалога, отправляемой модели.
MAX_HISTORY_TOKENS=4000
