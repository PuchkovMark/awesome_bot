# VK
VK_TOKEN=your_vk_group_token_here
VK_GROUP_ID=12345678

# Database (SQLite by default)
DATABASE_URL=file:./dev.db

# OpenCode Console
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Cloudflare Workers AI image generation and editing
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_EDIT_MODEL=@cf/runwayml/stable-diffusion-v1-5-inpainting

# App
PORT=3000
LOG_LEVEL=info
BOT_NAME=awesome_bot
CONTEXT_TTL_HOURS=24
MAX_HISTORY_TOKENS=4000
