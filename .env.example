# Токен доступа сообщества VK, используемый ботом для Long Poll и отправки сообщений.
VK_TOKEN=your_vk_group_token_here
# Необязательный сервисный ключ приложения VK для публичных записей, друзей, сообществ и фото.
VK_SERVICE_TOKEN=
# Числовой ID сообщества VK без префикса club.
VK_GROUP_ID=12345678

# URL единственной базы SQLite; относительный путь считается от prisma/schema.prisma.
DATABASE_URL=file:./dev.db

# API-ключ OpenAI; нужен для изображений, голоса и анализа медиа.
OPENAI_API_KEY=
# Необязательный ключ для семантического поиска памяти; по умолчанию используется OPENAI_API_KEY.
MEMORY_EMBEDDING_API_KEY=
# Модель OpenAI Embeddings; keyword-поиск остаётся доступен, если ключ не задан.
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Модель OpenAI для анализа изображений и документов.
OPENAI_MODEL=gpt-4.1-mini
# Название модели OpenAI для распознавания речи.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Название модели OpenAI для синтеза речи.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Глобально включает обработку голосовых; пользователь дополнительно включает её командой /voice on.
VOICE_ENABLED=true
# API-ключ OpenCode Console для основной текстовой модели.
OPENCODE_API_KEY=
# Основная текстовая модель OpenCode: deepseek-v4.1-flash или gemini-4-argon.
OPENCODE_MODEL=deepseek-v4.1-flash
# Уровень рассуждения: low, medium или high; по умолчанию low.
AI_EFFORT=low
# Общий лимит токенов рассуждения и ответа на один запрос к модели (не более 32768).
AI_MAX_OUTPUT_TOKENS=32768
# Базовый URL OpenCode API.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Название модели OpenAI Images API.
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Основной поисковый провайдер: none отключает поиск; serper и tavily автоматически переключаются друг на друга при сбое.
WEB_SEARCH_PROVIDER=serper
# API-ключи Serper и Tavily; для отказоустойчивости рекомендуется настроить оба.
SERPER_API_KEY=
TAVILY_API_KEY=
# Временная зона по умолчанию для «Мема дня» (IANA); беседа может задать собственную.
MEMEDAY_TIMEZONE=UTC

# Список VK ID администраторов через запятую; создатель Mark Puchkov (388581097) имеет высшую роль автоматически.
VK_ADMIN_IDS=
# Ограничивает доступ к генерации/редактированию изображений и анализу медиа администраторами.
IMAGE_ADMIN_ONLY=true
# Максимум операций генерации и редактирования изображений на пользователя за UTC-день.
IMAGE_MAX_PER_USER_PER_DAY=20
# Максимальное число автоматических повторов запроса к ИИ-провайдеру.
AI_MAX_RETRIES=2
# Максимальное число вызовов инструментов в одном ответе модели.
AI_MAX_TOOL_CALLS=10
# Быстрая модель для промежуточных выжимок истории.
SUMMARY_MODEL=claude-haiku-5-5
# Сколько сообщений отправлять в один промежуточный чанк.
SUMMARY_CHUNK_MESSAGES=300
# Максимальный размер текста одного чанка в символах.
SUMMARY_CHUNK_CHARS=12000
# Лимит вывода для промежуточной выжимки.
SUMMARY_CHUNK_OUTPUT_TOKENS=1200
# Максимальный лимит вывода при повторной попытке.
SUMMARY_CHUNK_OUTPUT_TOKENS_MAX=2400
# Максимальный размер структурированных выжимок, передаваемых основной модели.
SUMMARY_MAX_DIGEST_CHARS=8000
# Максимальный размер финального пересказа в символах.
SUMMARY_MAX_CHARS=2000
# Максимум сообщений, которые один субагент загружает из SQL за задачу.
SUBAGENT_MAX_MESSAGES=3000
# Минимальное фактическое число сообщений для запуска субагента.
SUBAGENT_MIN_MESSAGES=100
# Максимум шагов субагента (вызовов инструментов).
SUBAGENT_MAX_TOOL_CALLS=8
# Максимальная длина итогового ответа субагента.
SUBAGENT_MAX_OUTPUT_CHARS=2000
# Максимальное время выполнения задачи субагента.
SUBAGENT_TIMEOUT_MINUTES=30
# Максимальное время выполнения одной части split-задачи.
SUBAGENT_PART_TIMEOUT_MINUTES=15
# Максимум запусков субагента на пользователя за сутки.
SUBAGENT_DAILY_LIMIT=10
# Сколько задач субагентов выполняются одновременно.
SUBAGENT_CONCURRENCY=2
# Максимум частей, на которые можно разделить одну задачу.
SUBAGENT_MAX_PARTS=2
# Общий лимит одновременных запросов к LLM внутри субагентов.
SUBAGENT_PROVIDER_CONCURRENCY=6
# Сколько чанков summarize_history обрабатывать одновременно.
SUBAGENT_SUMMARIZE_CONCURRENCY=3
# Максимальный суммарный объём истории для одной задачи в символах.
SUBAGENT_MAX_SUMMARY_CHARS=300000
# Максимум чанков в одной задаче summarize_history.
SUBAGENT_MAX_SUMMARY_CHUNKS=25
# Оценочный лимит input-токенов до запуска задачи.
SUBAGENT_MAX_ESTIMATED_INPUT_TOKENS=90000
# Фактический лимит input-токенов на задачу.
SUBAGENT_MAX_INPUT_TOKENS=120000
# Фактический лимит output-токенов на задачу.
SUBAGENT_MAX_OUTPUT_TOKENS=35000
# Максимум вызовов summarize_history за задачу.
SUBAGENT_MAX_SUMMARIZE_CALLS=1
# Максимум результатов search_history за вызов.
SUBAGENT_MAX_SEARCH_RESULTS=50
# Сколько дней хранить завершённые job-записи и результаты.
SUBAGENT_RESULT_RETENTION_DAYS=7
# Максимум обрабатываемых запросов одного пользователя за минуту.
MAX_REQUESTS_PER_MINUTE=10
# Максимум сообщений истории, передаваемых в контекст модели.
MAX_HISTORY_MESSAGES=30
# Максимальная длина входящего текстового сообщения в символах.
MAX_INPUT_CHARS=12000

# Порт HTTP-сервера приложения, если он используется.
PORT=3000
# Уровень журналирования, например info, warn или error.
LOG_LEVEL=info
# Имя бота, распознаваемое как обращение к нему в беседе.
BOT_NAME=awesome_bot
# Срок хранения контекста в часах; приложение ограничивает значение максимумом 24 часа.
CONTEXT_TTL_HOURS=24
# Приблизительный лимит токенов истории диалога, отправляемой модели.
MAX_HISTORY_TOKENS=4000
