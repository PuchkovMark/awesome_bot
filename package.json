{
  "name": "awesome-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 100
  },
  "scripts": {
    "start": "node dist/app/cli.js start",
    "init:prompt": "node dist/app/cli.js init-prompt",
    "resolve:chat": "node dist/app/cli.js resolve-chat",
    "format": "npm run format:files -- --write",
    "format:check": "npm run format:files -- --check",
    "format:files": "prettier --no-editorconfig --ignore-path .gitignore \"{src,tests,scripts}/**/*.{js,cjs,mjs,ts,cts,mts}\" \"!src/storage/migrations/[0-9]*.ts\" eslint.config.mjs vitest.config.ts vitest.queue-load.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run lint && npm run check:catalog && npm run check:context && npm run check:traces && npm run format:check && npm run typecheck && node scripts/build-esm.mjs",
    "test": "vitest run",
    "check:traces": "node scripts/check-trace-boundary.mjs",
    "check:catalog": "node scripts/check-catalog-boundary.mjs",
    "test:queue-load": "vitest run --config vitest.queue-load.config.ts",
    "check:context": "node scripts/check-context-boundary.mjs",
    "eval:local": "node dist/evals/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/utils": "8.73.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "pino": "10.4.0",
    "vk-io": "4.10.1"
  }
}
