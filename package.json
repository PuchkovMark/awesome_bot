{
  "name": "awesome-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bootstrap.ts",
    "start": "node --experimental-specifier-resolution=node ./dist/bootstrap.js",
    "test": "node --import tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "axios": "^1.5.0",
    "dotenv": "^16.1.4",
    "node-cron": "^3.0.2",
    "openai": "^4.9.0",
    "p-queue": "^7.1.0",
    "pino": "^8.15.0",
    "pino-pretty": "^9.0.0",
    "sharp": "^0.35.5",
    "vk-io": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.4.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.0",
    "prisma": "^5.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.72.2"
  }
}
