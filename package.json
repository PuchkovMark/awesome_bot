{
  "name": "awesome-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run lint && npm run check:catalog && npm run check:context && npm run typecheck && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:catalog": "node scripts/check-catalog-boundary.mjs",
    "test:queue-load": "vitest run --config vitest.queue-load.config.ts",
    "check:context": "node scripts/check-context-boundary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/utils": "8.73.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "pino": "10.4.0"
  }
}
